# Valores NO secretos que la construccion necesita (2026-11-24).
#
# Las paginas se arman al construir la web (ver open-next.config.ts), asi
# que los datos de Sanity tienen que estar disponibles en ESE momento, no
# solo en el Worker (wrangler.jsonc "vars"). Son los mismos valores publicos
# de wrangler.jsonc. Sin esto, la web saldria con los clientes de respaldo
# de src/data/clients.ts.
#
# NUNCA poner aqui claves ni secretos: este archivo va al repositorio.
SANITY_PROJECT_ID=59r5krzd
SANITY_DATASET=production

# Panel propio, etapa 6 (el cambio, docs/panel-propio/plan-etapa-6.md): la web
# se arma con el contenido del repositorio (contenido/), ya no con Sanity.
# Para volver atrás: revertir este commit (Sanity sigue intacto).
CONTENT_SOURCE=archivos
